def quicksort_2(arr, low, high) {
    if (low < high) {
        pivo = arr[high];
        i = low - 1;
        for (j = low; j < high; j += 1) {
            if (arr[j] <= pivo) {
                i += 1;
                temp = arr[i];
                arr[i] = arr[j];
                arr[j] = temp;
            }
        }
        temp = arr[i + 1];
        arr[i + 1] = arr[high];
        arr[high] = temp;
        
        pi = i + 1;
        
        quicksort(arr, low, pi - 1);
        quicksort(arr, pi + 1, high);
    }
    return arr;
}
def mergesort_2(arr, l, r) {
    if (l < r) {
        m = (l + r) / 2;
        mergesort_2(arr, l, m);
        mergesort_2(arr, m + 1, r);
        
        esq = arr[l:m + 1];
        dir = arr[m + 1:r + 1];
        
        i = 0;
        j = 0;
        k = l;
        
        while (i < len(esq) and j < len(dir)) {
            if (esq[i] <= dir[j]) {
                arr[k] = esq[i];
                i += 1;
            } else {
                arr[k] = dir[j];
                j += 1;
            }
            k += 1;
        }
        
        while (i < len(esq)) {
            arr[k] = esq[i];
            i += 1;
            k += 1;
        }
        
        while (j < len(dir)) {
            arr[k] = dir[j];
            j += 1;
            k += 1;
        }
    }
    return arr;
}
def main() {
    print("Digite a quantidade de elementos:");
    n = input();
    
    lista = [];
    print("Digite os elementos inteiros:");
    for (k = 0; k < n; k += 1) {
        val = input();
        lista = lista + [val];
    }
    
    print("Vetor original:");
    print(lista);
    
    quicksort(lista, 0, n - 1);
    
    print("Vetor ordenado com sucesso:");
    print(lista);
}

main();
