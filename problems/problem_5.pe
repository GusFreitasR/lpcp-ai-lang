def mdc(n, m, r) {
    if (m % n == 0) {
        r[0] = n;
    } else if (n % m == 0) {
        r[0] = m;
    } else if (m > n) {
        mdc(n, m % n, r);
    } else {
        mdc(m, n, r);
    }
}

n = to_int(input());
m = to_int(input());
r = [0];

mdc(n, m, r);
print("MDC = " cat to_string(r[0]));
