def intervalo(n) {
    resultado = [];
    i = 0;
    while (i < n) {
        resultado = resultado + [i];
        i += 1;
    }
    return resultado;
}

def somatorio(valores) {
    if (len(valores) == 0) {
        return 0;
    }
    return valores[0] + somatorio(valores[1:]);
}

def ler_matriz(linhas) {
    return [[to_float(x) for x in split(input(), " ")] for k in intervalo(linhas)];
}

def somar(A, B) {
    return [[A[i][j] + B[i][j] for j in intervalo(len(A[0]))] for i in intervalo(len(A))];
}

def multiplicar(A, B) {
    return [[somatorio([A[i][k] * B[k][j] for k in intervalo(len(B))]) for j in intervalo(len(B[0]))] for i in intervalo(len(A))];
}

def imprimir_matriz(M) {
    for (linha in M) {
        texto = "";
        for (x in linha) {
            texto = texto cat to_string(x) cat " ";
        }
        print(texto);
    }
}

def main() {
    dimA = split(input(), " ");
    A = ler_matriz(to_int(dimA[0]));
    dimB = split(input(), " ");
    B = ler_matriz(to_int(dimB[0]));

    if (len(A) == len(B) and len(A[0]) == len(B[0])) {
        print("Soma:");
        imprimir_matriz(somar(A, B));
    } else {
        print("Impossivel somar: as matrizes tem dimensoes diferentes.");
    }

    if (len(A[0]) == len(B)) {
        print("Produto:");
        imprimir_matriz(multiplicar(A, B));
    } else {
        print("Impossivel multiplicar: colunas de A diferente de linhas de B.");
    }
}

main();
