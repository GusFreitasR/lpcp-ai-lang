def inserir(arvore, k) {
    if (len(arvore) == 0) {
        return [k, [], []];
    }
    if (k <= arvore[0]) {
        return [arvore[0], inserir(arvore[1], k), arvore[2]];
    }
    return [arvore[0], arvore[1], inserir(arvore[2], k)];
}

def construir(valores) {
    arvore = [];
    for (v in valores) {
        arvore = inserir(arvore, to_int(v));
    }
    return arvore;
}

def minimo(arvore, nivel) {
    if (len(arvore[1]) == 0) {
        return [arvore[0], nivel];
    }
    return minimo(arvore[1], nivel + 1);
}

def maximo(arvore, nivel) {
    if (len(arvore[2]) == 0) {
        return [arvore[0], nivel];
    }
    return maximo(arvore[2], nivel + 1);
}

def imprimir_niveis(arvore) {
    nivel = 0;
    atual = [arvore];
    while (len(atual) > 0) {
        texto = "";
        for (k in [no[0] for no in atual]) {
            texto = texto cat to_string(k) cat " ";
        }
        print("Nivel " cat to_string(nivel) cat ": " cat texto);

        proximos = [];
        for (no in atual) {
            if (len(no[1]) > 0) {
                proximos = proximos + [no[1]];
            }
            if (len(no[2]) > 0) {
                proximos = proximos + [no[2]];
            }
        }
        atual = proximos;
        nivel += 1;
    }
}

def main() {
    valores = split(input(), " ");
    if (len(valores) == 0) {
        print("Sequencia vazia");
    } else {
        arvore = construir(valores);

        menor = minimo(arvore, 0);
        print("Chave minima: " cat to_string(menor[0]) cat " (nivel " cat to_string(menor[1]) cat ")");

        maior = maximo(arvore, 0);
        print("Chave maxima: " cat to_string(maior[0]) cat " (nivel " cat to_string(maior[1]) cat ")");

        print("Arvore nivel a nivel:");
        imprimir_niveis(arvore);
    }
}

main();
